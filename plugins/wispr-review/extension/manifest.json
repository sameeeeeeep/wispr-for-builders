{
  "manifest_version": 3,
  "name": "Wispr Review",
  "version": "0.1.1",
  "description": "Review any website by voice. Point, hold fn, and speak. Each note pins to the element under your cursor with a crop, selector, and URL.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "scripting",
    "storage",
    "unlimitedStorage",
    "tabs",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Wispr Review: turn review on or off for this site (Option+Shift+R)",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "commands": {
    "toggle-review": {
      "suggested_key": {
        "default": "Alt+Shift+R",
        "mac": "Alt+Shift+R"
      },
      "description": "Turn voice review on or off on this site"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/Figtree.ttf"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "key": ""
}
